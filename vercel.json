{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/admin_panel",
      "destination": "/admin_panel/index.html"
    },
    {
      "source": "/admin_panel/",
      "destination": "/admin_panel/index.html"
    },
    {
      "source": "/admin_panel/:path*",
      "destination": "/admin_panel/index.html"
    },
    {
      "source": "/((?!admin_panel|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
